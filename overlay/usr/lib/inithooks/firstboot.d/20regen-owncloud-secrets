#!/bin/bash
set -Eeuo pipefail
# Regenerate the database and Redis credentials before ownCloud starts.

. /etc/default/inithooks

PASSWORD=$(mcookie)
REDIS_PASSWORD=$(mcookie)

mysql --batch --execute "ALTER USER 'owncloud'@'172.28.0.%' IDENTIFIED BY '$PASSWORD'; FLUSH PRIVILEGES;"
sed -i "s/^OWNCLOUD_DB_PASSWORD=.*/OWNCLOUD_DB_PASSWORD=$PASSWORD/" \
    /etc/owncloud/owncloud.env

sed -i "s/^requirepass .*/requirepass $REDIS_PASSWORD/" \
    /etc/redis/redis.conf
sed -i "s/^OWNCLOUD_REDIS_PASSWORD=.*/OWNCLOUD_REDIS_PASSWORD=$REDIS_PASSWORD/" \
    /etc/owncloud/owncloud.env
systemctl restart redis-server.service

touch /etc/owncloud/firstboot-ready
